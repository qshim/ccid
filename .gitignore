# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Lab Ops local data store (json backend)
/.labops-data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Apps Script write bridge — contains the shared secret, keep local
google-apps-script/doPost-write-bridge.gs

# 작업 도구·실험물 — 사이트 빌드와 무관
/.agents/
/.claude/skills/
/skills-lock.json
/public/style-lab/
# 외부 전달용으로 변환한 PNG 사본(58MB). 웹에서는 원본 webp 를 쓴다.
/public/img/imgs/
