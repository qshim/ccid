# cciD Lab (Research Operations) — environment variables.
# Copy to .env.local and fill in values. NEVER commit real values.
# No NEXT_PUBLIC_ prefixes here on purpose — all of these are server-only.

# --- Auth (required) ---
ADMIN_LOGIN_ID=
ADMIN_LOGIN_PASSWORD=
SESSION_SECRET=

# --- Data store ---
# "json" (default): local file .labops-data/labops.json — dev / self-hosted only
#   (NOT persistent on Vercel serverless).
# "sheets": Google Apps Script bridge — persistent on Vercel.
#   Requires the labops extension merged into the bridge script
#   (see google-apps-script/labops-bridge-extension.gs) and both vars below.
LAB_DATA_BACKEND=json
SHEETS_BRIDGE_URL=
SHEETS_BRIDGE_SECRET=

# --- Google Calendar / Meet (optional until configured) ---
# Google Cloud Console → OAuth client (Web) — see LAB_OPS.md for setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- AI (OpenAI) — server-only, never expose to client ---
OPENAI_API_KEY=
